# ==============================================================================
# ENVIRONMENT CONFIGURATION - STOCK ANALYSIS PLATFORM
# ==============================================================================

# Data Lakehouse Root Directory (relative to Stock_Analysis or absolute)
DATA_LAKE_ROOT=../DataLake
DATA_LAKE_PATH=../DataLake

# PostgreSQL Data Warehouse (Primary Admin / ETL Connection)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Stock_Warehouse
DB_USER=postgres
DB_PASS=your_postgres_password
GEMINI_API_KEY=your_gemini_api_key

# Read-Only Chatbot / Analytics Service Account (Least Privilege)
CHATBOT_DB_USER=chatbot_readonly
CHATBOT_DB_PASSWORD=chatbot_secure_pass

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
